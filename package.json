{
  "name": "weather-brasil-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server that provides weather information for Brazil using public APIs.",
  "license": "MIT",
  "type": "module",
  "author": "Diego Jose",
  "homepage": "https://github.com/diego-jose/weather-brasil-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/diego-jose/weather-brasil-mcp.git"
  },
  "keywords": [
    "mcp",
    "weather",
    "brazil",
    "typescript",
    "model-context-protocol"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "weather-brasil-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "start": "node dist/index.js",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.15.30",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}